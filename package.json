{
  "name": "thira-icons",
  "version": "0.1.0",
  "description": "Friendly, rounded stroke icons for React and plain HTML: drawn from scratch, with a Thai set",
  "keywords": [
    "icons",
    "react",
    "svg",
    "sprite",
    "thai"
  ],
  "homepage": "https://thiraphat-ps-dev.github.io/thira-icons/",
  "bugs": "https://github.com/thiraphat-ps-dev/thira-icons/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiraphat-ps-dev/thira-icons.git"
  },
  "license": "ISC",
  "author": "Thiraphat Phutson",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/icons/*.d.ts",
      "default": "./dist/react/icons/*.js"
    },
    "./svg/*": "./dist/svg/*",
    "./sprite.svg": "./dist/sprite.svg",
    "./icons.json": "./dist/icons.json",
    "./package.json": "./package.json",
    "./font/*": "./dist/font/*"
  },
  "files": [
    "dist",
    "!dist/font/*.ttf",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.json",
    "build:font": "python scripts/font.py",
    "site": "node scripts/site.mjs",
    "test": "tsc -p tsconfig.test.json && vitest run",
    "check": "npm run build && npm test",
    "lint:icons": "node scripts/lint-icons.mjs",
    "progress": "node scripts/progress.mjs"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "svg-path-bbox": "^2.1.0",
    "typescript": "~6.0",
    "vitest": "^5.1.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
